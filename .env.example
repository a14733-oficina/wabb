# SQLite (por defeito, não precisa de configuração):
# DATABASE_URL=sqlite:///./wabb.db
# Chave usada para assinar as sessões do login (altere em produção):
# WABB_SECRET=coloque-aqui-uma-chave-longa-e-aleatoria
# MySQL:
DATABASE_URL=mysql+pymysql://wabb_user:password@localhost:3306/wabb?charset=utf8mb4
